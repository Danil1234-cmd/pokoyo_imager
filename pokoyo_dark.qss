QMainWindow {
    background-color: #2b2b2b;
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 9pt;
    color: #dddddd;
}

QGroupBox {
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    margin-top: 8px;
    background: #323232;
}

QGroupBox::title {
    left: 10px;
    padding: 0 4px 0 4px;
    color: #ffffff;
    font-weight: 600;
}

QLabel {
    color: #dddddd;
}

QComboBox, QLineEdit {
    border: 1px solid #444;
    border-radius: 3px;
    padding: 4px;
    background: #3a3a3a;
    color: #ffffff;
}

QPushButton {
    border: 1px solid #444;
    border-radius: 3px;
    padding: 5px 12px;
    background: #3c3c3c;
    color: white;
}

QPushButton:hover {
    background: #505050;
}

QPushButton#btnStart {
    background-color: #0078d7;
    border: none;
    font-weight: bold;
}

QProgressBar {
    border: 1px solid #444;
    border-radius: 3px;
    background: #3a3a3a;
    height: 18px;
}

QProgressBar::chunk {
    background-color: #0078d7;
}

QTextEdit {
    border: 1px solid #444;
    background: #1e1e1e;
    font-family: Consolas, monospace;
    font-size: 8pt;
}
